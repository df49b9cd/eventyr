# The compose-managed deployment's credentials and host port. Copy to
# `.env` (which stays untracked) and set `POSTGRES_PASSWORD` before
# `docker compose up`. The defaults match `./scripts/dev-services.sh`,
# the dev loop's throwaway container — these are not production secrets.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eventyr
EVENTYR_SAMPLE_PG_PORT=55432
